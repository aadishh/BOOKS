# ===================================
# Root-level ignores
# ===================================

# Node modules (ignore all unless explicitly included)
node_modules/
.vscode/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*.local

# OS files
.DS_Store
Thumbs.db

# Build output (can appear in either frontend or backend)
dist/
build/
.cache/
.next/
out/
coverage/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Dependency directories (redundant, but safe)
frontend/node_modules/
backend/node_modules/

# ===================================
# Frontend (Next.js - frontend)
# ===================================

# Next.js build output
frontend/.next/
frontend/.vercel/

# TypeScript build files
frontend/*.tsbuildinfo

# ===================================
# Backend (Node.js / Express / API)
# ===================================

# Build artifacts
backend/dist/
backend/build/

# Environment files
backend/.env
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local

# TypeScript build info
backend/*.tsbuildinfo

# ===================================
# Miscellaneous
# ===================================

# Temporary files
tmp/
temp/
*.tmp

# Coverage reports
coverage/
lcov-report/

# Package manager lockfiles (if using multiple managers)
package-lock.json
yarn.lock
pnpm-lock.yaml
